{
  "name": "@noppu-labs/opencode-cache-manager",
  "version": "0.6.1",
  "description": "Prompt-cache manager for OpenCode V2: per-session 5m / 1h / hybrid TTL and keepalive pings for Claude and OpenAI GPT-5.6+ on the Anthropic Messages, Chat Completions and Responses APIs (OpenRouter, proxies), plus a sidebar cache status",
  "keywords": [
    "anthropic",
    "bun",
    "cache-keepalive",
    "cache-ttl",
    "claude",
    "gpt",
    "keepalive",
    "openai",
    "openai-compatible",
    "opencode",
    "opencode-plugin",
    "openrouter",
    "prompt-caching",
    "tui",
    "typescript"
  ],
  "homepage": "https://github.com/noppu-labs/opencode-cache-manager",
  "bugs": {
    "url": "https://github.com/noppu-labs/opencode-cache-manager/issues"
  },
  "license": "MIT",
  "author": "cris005",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noppu-labs/opencode-cache-manager.git"
  },
  "files": [
    "LICENSE",
    "README.md",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./src/server.ts",
    "./server": "./src/server.ts",
    "./tui": "./src/tui.ts",
    "./rpc": "./src/rpc.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test tests/",
    "typecheck": "tsc -p .",
    "build": "bun scripts/build-sidebar.ts",
    "prepack": "bun run build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@opencode/theme": "2.2.0",
    "@opentui/core": "0.7.0",
    "@opentui/solid": "0.7.0",
    "@types/bun": "^1.4.4",
    "eslint": "^10.13.0",
    "eslint-plugin-solid": "^0.18.1",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "solid-js": "1.9.17",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.22 <3",
    "@opentui/core": ">=0.5.14",
    "@opentui/solid": ">=0.5.14",
    "solid-js": ">=1.9.0"
  },
  "engines": {
    "bun": ">=1.3.0",
    "opencode": ">=2.0.22 <3"
  }
}
