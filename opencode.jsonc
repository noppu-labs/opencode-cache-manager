// Sample opencode.jsonc for the anthropic-cache-ttl plugin (opencode-cache-manager).
//
// This fixture is also used by the test suite (tests/anthropic-cache-ttl.test.ts).
// To use the plugin with your own setup, copy the "omniroute-anthropic" provider
// below into your ~/.config/opencode/opencode.jsonc, or point it at any
// Anthropic-compatible endpoint. The authToken is an env-var reference, so
// there are no secrets in this file.
//
// Plugin options (keepalive and the default TTL mode) go in the plugin entry of
// your own opencode.jsonc, not in this file. Every value is optional and the
// ones shown are the defaults, except defaultMode, which defaults to "5m":
//
//   "plugins": [
//     {
//       "package": "@noppu-labs/opencode-cache-manager",
//       "options": {
//         "defaultMode": "1h",
//         "keepalive": {
//           "enabled": true,
//           "maxPings": 5,
//           "minContextTokens": 50000
//         }
//       }
//     }
//   ]
{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "omniroute-anthropic": {
      "name": "OmniRoute (Anthropic)",
      "package": "@opencode/ai/providers/anthropic-compatible",
      "settings": {
        "baseURL": "https://omniroute.linksy.au/v1",
        "authToken": "{env:OMNIROUTE_API_KEY}"
      },
      "models": {
        "auto/claude-haiku-5-5": {
          "name": "Haiku 5.5",
          "cost": {
            "input": 0.1,
            "output": 0.5,
            "cache": {
              "read": 0.01,
              "write": 0.125
            }
          },
          "capabilities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 100000
          },
          "variants": [
            {
              "id": "none",
              "settings": {
                "reasoningEffort": "none"
              }
            },
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low"
              }
            },
            {
              "id": "medium",
              "settings": {
                "reasoningEffort": "medium"
              }
            },
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high"
              }
            },
            {
              "id": "xhigh",
              "settings": {
                "reasoningEffort": "xhigh"
              }
            },
            {
              "id": "max",
              "settings": {
                "reasoningEffort": "max"
              }
            },
            {
              "id": "none-1h",
              "settings": {
                "reasoningEffort": "none"
              },
              "headers": {
                "x-cache-ttl": "1h"
              }
            },
            {
              "id": "low-1h",
              "settings": {
                "reasoningEffort": "low"
              },
              "headers": {
                "x-cache-ttl": "1h"
              }
            },
            {
              "id": "medium-1h",
              "settings": {
                "reasoningEffort": "medium"
              },
              "headers": {
                "x-cache-ttl": "1h"
              }
            },
            {
              "id": "high-1h",
              "settings": {
                "reasoningEffort": "high"
              },
              "headers": {
                "x-cache-ttl": "1h"
              }
            },
            {
              "id": "xhigh-1h",
              "settings": {
                "reasoningEffort": "xhigh"
              },
              "headers": {
                "x-cache-ttl": "1h"
              }
            },
            {
              "id": "max-1h",
              "settings": {
                "reasoningEffort": "max"
              },
              "headers": {
                "x-cache-ttl": "1h"
              }
            }
